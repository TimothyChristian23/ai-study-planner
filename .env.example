# Browser-safe Supabase client values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-side only values for Supabase Edge Functions
# AI_PROVIDER can be gemini or openai. Gemini is the free-first default path.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ANSWER_MODEL=gemini-2.5-flash

# Optional OpenAI fallback/alternative
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5-mini
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
INDEX_WORKER_SECRET=replace-with-a-long-random-worker-secret

# Optional deployment smoke test values
AI_STUDY_APP_URL=https://timothychristian23.github.io/ai-study-planner
SUPABASE_SMOKE_EMAIL=smoke-user@example.com
SUPABASE_SMOKE_PASSWORD=replace-with-dedicated-smoke-user-password
SUPABASE_SMOKE_ACCESS_TOKEN=optional-signed-in-test-user-access-token-if-not-using-email-password
SUPABASE_SMOKE_CLIENT_PREFIX=ai-study-smoke
SUPABASE_SMOKE_RUN_AI=false

# Optional indexing operations monitor values
INDEX_MONITOR_FAILED_THRESHOLD=0
INDEX_MONITOR_STALE_RUNNING_THRESHOLD=0
INDEX_MONITOR_OVERDUE_QUEUED_THRESHOLD=20
INDEX_MONITOR_STALE_MINUTES=10
INDEX_MONITOR_DETAIL_LIMIT=10
